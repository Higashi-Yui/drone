#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import rospy
import cv2
import numpy as np
from geometry_msgs.msg import Point
from std_msgs.msg import Bool
import time
import math

# 相机参数
#camera_matrix = np.array([
#    [508.78157505, 0, 322.78201003],
#    [0, 516.05757226, 236.31819429],
#    [0, 0, 1]
#])
#dist_coeffs = np.array([-0.00703991, 0.31814569, -0.00329183, -0.00170783, -1.00915292])

REAL_WIDTH = 0.1
OFFSET_Y_REAL = 0

camera_matrix = np.array([
    [506.142358, 0, 308.46348627],
    [0, 503.54022763, 229.74875316],
    [0, 0, 1]
])
dist_coeffs = np.array([0.06507472, -0.20553698, -0.00187582, -0.00172221, 0.21452783])

# 互补滤波权重
ALPHA = 0.4

# 上一时刻数据
last_body_x = None
last_body_y = None
last_Z = None


def main():
    global last_body_x, last_body_y, last_Z

    rospy.init_node('vision_error_node')

    pub_point = rospy.Publisher('/camera/object_offset', Point, queue_size=10)
    pub_detected = rospy.Publisher('/camera/object_detected', Bool, queue_size=10)
    rate = rospy.Rate(30)

    cap = cv2.VideoCapture('/dev/video0',cv2.CAP_V4L2)
    if not cap.isOpened():
        rospy.logerr("Cannot open camera")
        return
    rospy.loginfo("All set")
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 320)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 240)
    cap.set(cv2.CAP_PROP_AUTO_EXPOSURE, 1)   # 关闭自动曝光
    cap.set(cv2.CAP_PROP_EXPOSURE, 700)      # 手动曝光值
    frame_count = 0
    last_time = time.time()

    while not rospy.is_shutdown():

        ret, frame = cap.read()
        if not ret:
            rospy.logwarn("Camera read failed")
            continue

        frame_count += 1
        now = time.time()
        if now - last_time >= 1.0:
            frame_count = 0
            last_time = now

        frame = cv2.undistort(frame, camera_matrix, dist_coeffs)

        height, width = frame.shape[:2]
        cx = width / 2
        cy = height / 2

        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        # 绿色的 HSV 范围
        # Hue (色调): 35-85 左右是绿色区间
        # Saturation (饱和度): 43-255，较低的值会包含浅绿色
        # Value (亮度): 46-255，较低的值会包含深绿色
        # lower_purple = np.array([120, 44, 56])
        # upper_purple = np.array([160, 255, 255])
        # # 只需要一个 inRange 即可
        # mask = cv2.inRange(hsv, lower_purple, upper_purple)
        lower_red1 = np.array([0,43,56])
        upper_red1 = np.array([10,255,255])

        lower_red2 = np.array([170,43,56])
        upper_red2 = np.array([180,255,255])

        mask = cv2.inRange(hsv, lower_red1, upper_red1) + cv2.inRange(hsv, lower_red2, upper_red2)
        #lower_blue = np.array([90, 43, 46])
        #upper_blue = np.array([130, 255, 255])
        #mask = cv2.inRange(hsv, lower_blue, upper_blue)
        contours,_ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

        max_area = 0
        best_cnt = None

        for cnt in contours:
            area = cv2.contourArea(cnt)
            if area < 800:
                continue
            if area > max_area:
                max_area = area
                best_cnt = cnt

        detected = False
        body_x = body_y = Z = 0.0

        if best_cnt is not None:

            detected = True

            x,y,w,h = cv2.boundingRect(best_cnt)

            fx = camera_matrix[0,0]
            fy = camera_matrix[1,1]

            Z = fx * REAL_WIDTH / w

            obj_x = x + w/2
            obj_y = y + h/2

            offset_pixel_y = fy * OFFSET_Y_REAL / Z

            pickup_x = cx
            pickup_y = cy - offset_pixel_y

            dx = (pickup_x - obj_x) * Z / fx
            dy = (pickup_y - obj_y) * Z / fy

            body_x = -dy
            body_y = -dx

            # ---------- 互补滤波 ----------
            if last_body_x is None:
                last_body_x = body_x
                last_body_y = body_y
                last_Z = Z
            else:
                body_x = ALPHA * body_x + (1 - ALPHA) * last_body_x
                body_y = ALPHA * body_y + (1 - ALPHA) * last_body_y
                Z = ALPHA * Z + (1 - ALPHA) * last_Z

                last_body_x = body_x
                last_body_y = body_y
                last_Z = Z

            # ---------- 保留四位小数 ----------
            # body_x = round(body_x, 4)
            # body_y = round(body_y, 4)
            # Z = round(Z, 4)
            body_x = int(body_x * 100) / 100
            body_y = int(body_y * 100) / 100
            Z = int(Z * 100) / 100
            msg_point = Point()
            msg_point.x = -1*body_x
            msg_point.y = -1*body_y
            msg_point.z = Z

            pub_point.publish(msg_point)

        msg_detected = Bool()
        msg_detected.data = detected
        pub_detected.publish(msg_detected)

        rate.sleep()

    cap.release()


if __name__ == "__main__":
    try:
        main()
    except rospy.ROSInterruptException:
        pass
